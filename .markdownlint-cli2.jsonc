{
  // Rules disabled because existing docs trip them; CI still enforces all
  // other markdownlint rules and catches future regressions.
  "config": {
    "MD013": false, // line-length (long prose lines, intentional)
    "MD060": false, // table-column-style (cosmetic pipe spacing)
    "MD040": false, // fenced-code-language
    "MD034": false, // no-bare-urls
    "MD032": false, // blanks-around-lists
    "MD022": false, // blanks-around-headings
    "MD038": false  // no-space-in-code
  },
  "globs": ["**/*.md"],
  // The PR template is a form GitHub pastes into a textarea, not a document:
  // MD041 (first-line-h1) does not apply, since GitHub supplies the title.
  "ignores": ["node_modules", ".github/PULL_REQUEST_TEMPLATE.md"]
}
